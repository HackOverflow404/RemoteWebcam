/* General Window */
QMainWindow {
    background-color: #1e1e1e;
}

/* Buttons */
QPushButton {
    background-color: #3b82f6;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 18px;
    padding: 14px 24px;
    min-width: 240px;
    max-width: 300px;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #777;
}

QPushButton[checkable="true"]:!checked {
    background-color: white;
    color: #3b82f6;
}

QPushButton[checkable="true"]:checked {
    background-color: #3b82f6;
    color: white;
}

/* Labels */
QLabel#titleLabel {
    color: white;
    font-size: 35px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}

QLabel#connectionStatus {
    font-size: 16px;
    font-weight: 500;
    padding-top: 12px;
    qproperty-alignment: AlignCenter;
}

QLabel#previewLabel {
    color: white;
    font-size: 24px;
    font-weight: bold;
    padding-left: 12px;
}

/* Preview Frame */
QWidget#previewFrame {
    background-color: #2c2c2c;
    border-radius: 12px;
    border: 1px solid #444;
    min-height: 400px;
    min-width: 600px;
}